{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ],
  "flux": {
    "managerFilePatterns": ["/yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/yaml$/"]
  },
  "ignorePaths": ["**/talos/**", "**/template/**"],
  "prConcurrentLimit": 0,
  "assignees": [
    "UntouchedWagons"
  ],
  "reviewers": [
    "UntouchedWagons"
  ]
}
